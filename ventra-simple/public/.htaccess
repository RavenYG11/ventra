# Header COOP/COEP untuk deploy XAMPP (Apache).
# WAJIB agar SQLite OPFS SAH pool (SharedArrayBuffer) jalan di http://localhost/ventra-simple.
# Pastikan mod_headers aktif di XAMPP (biasanya sudah aktif by default).
<IfModule mod_headers.c>
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "require-corp"
</IfModule>
